name: Build and release Trame

on:
  pull_request:
  push:
    branches: ['**']
    tags: ['v[0-9]*.[0-9]*.[0-9]*']

permissions:
  contents: read

jobs:
  build:
    if: github.event.deleted != true
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - name: Test the shared engine and its macOS adapter
        run: |
          cargo test --locked --manifest-path Core/Cargo.toml
          ./scripts/swift-with-core.sh test
      - name: Install Rust targets for the universal app
        if: github.ref_type == 'tag'
        run: rustup target add aarch64-apple-darwin x86_64-apple-darwin
      - name: Build the universal app
        if: github.ref_type == 'tag'
        env:
          BUILD_TAG: ${{ github.ref_name }}
        run: ./scripts/build-app.sh --release "$BUILD_TAG"
      - name: Save the release archive
        if: github.ref_type == 'tag'
        uses: actions/upload-artifact@v4
        with:
          name: trame-release
          path: dist/Trame-${{ github.ref_name }}-macOS-universal.zip
          if-no-files-found: error

  android:
    if: github.event.deleted != true
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - name: Install Android build targets
        run: |
          rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android i686-linux-android
          sdkmanager "platforms;android-36" "build-tools;36.0.0" "ndk;27.1.12297006"
      - name: Validate the Android package with a disposable signing key
        run: ANDROID_NDK_HOME="$ANDROID_HOME/ndk/27.1.12297006" ./scripts/build-android.sh

  publish:
    needs: [build, android]
    if: github.ref_type == 'tag'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: trame-release
      - name: Publish GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          TAG: ${{ github.ref_name }}
        run: |
          gh release create "$TAG" "Trame-$TAG-macOS-universal.zip" \
            --verify-tag --title "Trame ${TAG#v}" --generate-notes
